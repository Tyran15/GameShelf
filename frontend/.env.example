# URL de conexão do PostgreSQL local (docker-compose.yml)
DATABASE_URL="postgresql://gameshelf:gameshelf@localhost:5432/gameshelf?schema=public"

# Porta da API (opcional, padrão 3000)
PORT=3000

# Segredo para assinar o JWT. Gere um com: openssl rand -base64 48
JWT_SECRET=""

# Origens permitidas no CORS, separadas por vírgula (padrão: localhost 5173, 3000 e 8080)
CORS_ORIGINS="http://localhost:8080"

# Chaves das APIs externas
RAWG_API_KEY=""
STEAMGRIDDB_API_KEY=""
