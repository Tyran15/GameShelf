# URL de conexão do PostgreSQL local (docker-compose.yml)
DATABASE_URL="postgresql://gameshelf:gameshelf@localhost:5432/gameshelf?schema=public"

# Porta da API (opcional, padrão 3000)
PORT=3000

STEAMGRIDDB_API_KEY="0ff10fcf527e29fb3dd4f7fd934a5fb1"

# Segredo para assinar o JWT (gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=""

# URL do frontend: usada no link do e-mail de recuperação de senha
FRONTEND_URL="http://localhost:5173"

# SMTP para enviar e-mails. Deixe SMTP_HOST vazio em desenvolvimento: o link de
# recuperação é impresso no terminal da API em vez de enviado.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="GameShelf <no-reply@gameshelf.local>"
